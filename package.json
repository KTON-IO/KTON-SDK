{
  "name": "kton-sdk",
  "version": "2.0.1",
  "description": "Stake TON into the KTON and pKTON liquid staking pools: pool data, balances and TonConnect messages, read from TonCenter",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/kton-sdk.global.js",
  "jsdelivr": "./dist/kton-sdk.global.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run check && npm run test:run && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTON-IO/KTON-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/KTON-IO/KTON-SDK/issues"
  },
  "homepage": "https://github.com/KTON-IO/KTON-SDK#readme",
  "author": {
    "name": "KTON Team",
    "url": "https://github.com/KTON-IO"
  },
  "license": "MIT",
  "keywords": [
    "kton",
    "pkton",
    "ton",
    "liquid-staking",
    "staking",
    "tonconnect",
    "sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@ton/core": ">=0.60.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@tonconnect/sdk": "4.0.2",
    "@tonconnect/ui": "3.0.2",
    "@types/node": "26.6.3",
    "buffer": "6.0.3",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
